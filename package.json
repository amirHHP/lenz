{
  "name": "lenz",
  "version": "1.0.0",
  "description": "minimalist rss reader with sorting system",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "vitest run"
  },
  "bugs": {
    "url": "https://github.com/amirHHP/lenz/issues"
  },
  "homepage": "https://github.com/amirHHP/lenz#readme",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dompurify": "^3.4.15",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.47.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
